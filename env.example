# Copy to backend/.env and fill in. Never commit .env.

# Claude API key from the Claude Console. Leave blank to run in MOCK mode.
ANTHROPIC_API_KEY=

# Model used to write the restoration plan.
# Check current model names at https://docs.claude.com
CLAUDE_MODEL=claude-sonnet-5-5

# Comma-separated origins allowed to call the backend (your Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (put in frontend/.env.local): backend URL
# VITE_API_URL=http://localhost:8000
